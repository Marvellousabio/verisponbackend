NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# Supabase Postgres. Panel > Settings > Database.
#
# There are two different strings and they are not interchangeable:
#
#   DIRECT  postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=verify-full
#           Used ONLY for `npm run db:migrate`. The migration runner takes a
#           session-scoped advisory lock to stop two deploys applying the same
#           file, and a pooler drops that session between statements.
#
#   POOLER  postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full
#           Used for the running API and worker. Supabase's connection budget is
#           shared with the dashboard and any other client, and this service
#           opens up to 10 connections per process; the pooler multiplexes them
#           onto a small number of server sessions.
#
# Use sslmode=verify-full rather than require. `require` is verified today, but
# pg-connection-string warns that it becomes unverified in pg v9.
#
# The password must be URL-encoded if it contains reserved characters.
DATABASE_URL=postgresql://postgres:password@localhost:5432/verispon

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Only set this when the API is served from a different registrable domain than
# the web origin. SameSite compares domains, not origins, so the usual
# verispon.com / api.verispon.com split works with the default of lax.
# SESSION_SAME_SITE=none

# Keep workers off in the API process; run them as a separate Render worker.
ENABLE_WORKERS=false
# Leave unset until the business chooses the inspection duration.
AUTO_RELEASE_HOURS=

# Cloudinary, used only for evidence uploads. Cloudinary console > Settings.
#
# Three values are required and readiness stays 503 without all three.
# The API key and secret are the account API key pair, not a preset.
#
# Evidence is uploaded with type=authenticated, so an asset is not readable from
# a plain res.cloudinary.com URL. Cloudinary's delivery signature has no expiry,
# so the signed URL is treated as a permanent credential: the service streams the
# bytes through GET /api/evidence/:transactionId/:file and never hands that URL
# to a client. Do not "optimise" this into a redirect.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nomba sandbox. Configure API and webhook secrets from the Nomba dashboard.
NOMBA_API_BASE_URL=https://sandbox.nomba.com
NOMBA_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
NOMBA_CLIENT_ID=replace-me
NOMBA_CLIENT_SECRET=replace-me
NOMBA_WEBHOOK_SECRET=replace-me

# Meta WhatsApp Cloud API.
META_WHATSAPP_TOKEN=replace-me
META_WHATSAPP_PHONE_NUMBER_ID=replace-me
META_APP_SECRET=replace-me
META_WEBHOOK_VERIFY_TOKEN=replace-me
META_GRAPH_VERSION=v23.0

# Resend transactional email.
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=notifications@verispon.com
